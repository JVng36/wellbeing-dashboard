{
  "name": "local-wellbeing-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts --dev",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:e2e": "npm run build && node scripts/supervisor-e2e.mjs",
    "test:smoke": "npm run build && node scripts/supervisor-smoke.mjs",
    "test:supervisor-smoke": "npm run build && node scripts/supervisor-smoke.mjs",
    "import:legacy": "node --import tsx src/server/import-cli.ts",
    "backup": "node --import tsx src/server/backup-cli.ts",
    "demo:seed": "node --import tsx src/server/demo-seed.ts"
  },
  "dependencies": {
    "@fastify/secure-session": "8.4.0",
    "@fastify/static": "10.1.5",
    "@node-rs/argon2": "2.0.2",
    "fastify": "5.12.5",
    "luxon": "3.7.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "yaml": "2.9.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/luxon": "3.7.1",
    "@types/node": "24.6.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
