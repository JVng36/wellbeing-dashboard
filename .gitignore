# Explicit root allowlist. Deployment/runtime material is not distributable.
/*
!/.gitignore
!/README.md
!/SECURITY.md
!/package.json
!/package-lock.json
!/index.html
!/tsconfig.json
!/tsconfig.server.json
!/vite.config.ts
!/vitest.config.ts
!/playwright.config.ts
!/src/
!/tests/
!/fixtures/
!/migrations/
!/scripts/
!/docs/

# Never commit dependencies, generated artifacts, credentials or journals.
node_modules/
dist/
dist-server/
coverage/
playwright-report/
test-results/
screenshots/
.env
.env.*
*.sqlite*
*.db
*.db-*
*.log
*.csv
*.token
*.key
*.pem
*.p12
*.pfx
*.bak
*.backup
*.zip
*.tar
*.tar.gz
session.key
id_rsa*
id_ed25519*
*secrets*
*credentials*
.wellbeing-data/
data/
backups/
exports/
private/
packet-provenance*/
docs/reviews/
task-*
